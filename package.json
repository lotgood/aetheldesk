{
  "name": "aetheldesk-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:css": "tailwindcss -i frontend/tailwind.input.css -o frontend/tailwind.css --content 'frontend/*.html' --minify",
    "build": "npm run build:css && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:frontend": "node --test tests/js/*.test.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
